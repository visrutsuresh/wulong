# .env.example — copy to .env and fill in your values.
# .env is gitignored and never committed.
#
# Usage:
#   cp .env.example .env
#   # Edit .env and replace each placeholder with your real value.

# --- Core ---
# Root of your wulong vault (set if you run scripts from outside the repo).
# Defaults to the script's grandparent directory if unset.
WULONG_ROOT=/path/to/your/vault

# --- GitHub integration (optional) ---
# A personal access token with read:packages scope.
# Used by compile-context.py to fetch live-state data from private repos.
# Leave blank to disable GitHub fetch (safe default).
GITHUB_TOKEN=

# --- Dashboard (optional) ---
# Base URL for your wulong dashboard, e.g. https://yourusername.github.io/wulong
# Used by health-scan.py to verify the dashboard is reachable.
# Leave blank to skip dashboard check.
WULONG_DASHBOARD_BASE=

# --- macOS launchd integration (optional) ---
# Directory where launchd writes logs for the wulong watch-meta job.
# Defaults to ~/Library/Logs/com.wulong
WULONG_LAUNCHD_LOG_DIR=~/Library/Logs/com.wulong

# Label for your launchd plist (used by cerebrum-health.py).
WULONG_LAUNCHD_LABEL=com.wulong.watch-meta

# --- Research router (optional) ---
# Pipe-separated list of trading/project repo names that research-router.py
# should route queries to. Leave blank if not using the research router.
# Example: WULONG_TRADING_REPOS=my_trader|my_bot
WULONG_TRADING_REPOS=
